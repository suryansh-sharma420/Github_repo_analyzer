GITHUB_TOKEN=your_token_here
CACHE_TTL_HOURS=1

# Max requests per client (IP) per minute for abuse-prone endpoints. 0 disables.
RATE_LIMIT_PER_MINUTE=30

# Upper bound on cached repositories; oldest rows are evicted past this.
MAX_CACHE_ROWS=500

# Seconds to wait before retrying GitHub's (async) commit-activity stats.
COMMIT_ACTIVITY_RETRY_DELAY=2.0

# Comma-separated CORS allowlist for the frontend origin(s).
ALLOWED_ORIGINS=http://localhost:3000

# Optional. When set, DELETE /repo requires a matching X-API-Key header.
# ADMIN_API_KEY=change-me
